{
  "name": "ioai-platform",
  "version": "1.0.0",
  "description": "IOAI Learning Platform",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "setup": "node scripts/install-electron.js",
    "create-icon": "node scripts/create-icon.js",
    "build": "node scripts/create-icon.js && electron-builder --win portable"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ioai.platform",
    "productName": "IOAI Prep",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "content/**/*",
      "lib/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
